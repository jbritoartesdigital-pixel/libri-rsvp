{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "libri-rsvp",
  "main": "./src/index.js",
  "compatibility_date": "2026-08-15",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/admin*", "/cliente/*", "/e/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "libri-rsvp-db",
      "database_id": "COLE_AQUI_O_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "enabled": true
  }
}
