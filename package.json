{
  "name": "libri-rsvp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply libri-rsvp-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply libri-rsvp-db --remote",
    "test": "node --test tests/*.test.mjs",
    "check": "node --check src/index.js && node --check src/passkeys.js && node --check src/guest-extras.js && node --check src/checkin.js && node --check public/app.js && node --check public/import-wizard.js"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  },
  "dependencies": {
    "@simplewebauthn/server": "13.2.2",
    "qrcode": "1.5.4"
  }
}
